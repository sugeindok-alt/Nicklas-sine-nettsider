PORT=3000
APP_ORIGIN=http://localhost:3000
# Leave empty to use persistent, embedded PostgreSQL in .data/.
DATABASE_URL=
# Production requires HTTPS and APP_ORIGIN=https://your-domain.example
# Reverse proxy must support WebSocket upgrades. Run one server instance.
EXTRA_ORIGINS=
# Render supplies RENDER_EXTERNAL_URL; omit APP_ORIGIN there to use it.
# Set DATABASE_URL to persistent PostgreSQL with sslmode=verify-full.
